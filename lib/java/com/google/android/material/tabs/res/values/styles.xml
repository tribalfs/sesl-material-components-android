<!--SESL Variant-->

<resources>

  <style name="Widget.Design.TabLayout" parent="Base.Widget.Design.TabLayout">
    <item name="seslDatePickerStyle">false</item><!--sesl9-->
    <item name="seslTabApplyBlur">false</item><!--sesl9-->
    <item name="tabGravity">fill</item>
    <item name="tabMode">fixed</item>
    <item name="tabIndicatorFullWidth">true</item>
  </style>

  <style name="Base.Widget.Design.TabLayout" parent="Base.V7.Widget.Design.TabLayout" />
  <style name="Base.V7.Widget.Design.TabLayout" parent="android:Widget">
    <item name="android:background">@null</item>
    <item name="tabIconTint">@null</item>
    <item name="tabMaxWidth">@dimen/sesl_tab_max_width</item><!--sesl-->
    <item name="tabIndicatorAnimationDuration">@integer/design_tab_indicator_anim_duration_ms</item>
    <item name="tabIndicatorColor">@color/sesl_tablayout_selected_indicator_color_dark</item><!--sesl-->
    <item name="tabIndicatorGravity">bottom</item>
    <item name="tabIndicatorAnimationMode">linear</item>
    <item name="tabIndicator">@drawable/sesl_tabs_default_indicator</item><!--sesl-->
    <item name="tabPaddingStart">10dp</item><!--sesl-->
    <item name="tabPaddingEnd">10dp</item><!--sesl-->
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab</item>
    <item name="tabTextColor">@null</item>
    <item name="tabRippleColor">@null</item><!--sesl-->
    <item name="tabUnboundedRipple">false</item>
    <!--Sesl-->
    <item name="tabPaddingTop">0dp</item>
    <item name="tabPaddingBottom">0dp</item>
    <item name="tabIndicatorHeight">2dp</item>
    <item name="tabBackground">@drawable/sesl_tabview_transparent_ripple_background_dark</item>
    <item name="seslTabSubTextAppearance">@style/TextAppearance.Design.Tab.SubText</item>
    <item name="tabSelectedTextColor">@color/sesl_tablayout_selected_text_color_dark</item>
    <!--sesl-->
  </style>

  <style name="TextAppearance.Design.Tab" parent="TextAppearance.AppCompat.Button">
    <item name="android:textSize">@dimen/sesl_tab_text_size</item><!--sesl-->
    <item name="android:textColor">@color/sesl_tablayout_text_color_dark</item><!--sesl-->
    <item name="textAllCaps">false</item><!--sesl-->
    <item name="android:textStyle">@string/sesl_text_style_medium</item><!--sesl-->
    <item name="android:fontFamily">@string/sesl_font_family_medium</item><!--sesl-->
  </style>

  <style name="Widget.MaterialComponents.TabLayout" parent="Widget.Design.TabLayout">
    <item name="enforceMaterialTheme">true</item>
    <item name="enforceTextAppearance">true</item>
    <item name="android:background">?attr/colorSurface</item>
    <item name="tabIconTint">@color/sesl_tabs_icon_color_selector</item><!--sesl-->
    <item name="tabIndicatorAnimationDuration">@integer/mtrl_tab_indicator_anim_duration_ms</item>
    <item name="tabIndicatorColor">?attr/colorPrimary</item>
    <item name="tabTextAppearance">?attr/textAppearanceButton</item>
    <item name="tabTextColor">@color/sesl_tabs_icon_color_selector</item><!--sesl-->
    <item name="tabRippleColor">@color/sesl_tabs_ripple_color</item><!--sesl-->
    <item name="tabUnboundedRipple">true</item>
  </style>

  <style name="Widget.MaterialComponents.TabLayout.Colored">
    <item name="android:background">?attr/colorPrimary</item>
    <item name="tabIconTint">@color/sesl_tabs_icon_color_selector_colored</item><!--sesl-->
    <item name="tabIndicatorColor">?attr/colorOnPrimary</item>
    <item name="tabTextColor">@color/sesl_tabs_icon_color_selector_colored</item><!--sesl-->
    <item name="tabRippleColor">@color/sesl_tabs_colored_ripple_color</item><!--sesl-->
  </style>

  <style name="Widget.MaterialComponents.TabLayout.PrimarySurface" parent="Widget.MaterialComponents.TabLayout.Colored"/>

  <!-- Styles for M3 Tabs -->
  <style name="Base.Widget.Material3.TabLayout" parent="Widget.MaterialComponents.TabLayout">
    <item name="android:background">?colorSurface</item><!--sesl-->
    <item name="enforceTextAppearance">false</item>
    <item name="tabIconTint">@color/m3_tabs_icon_color</item>
    <item name="tabTextAppearance">?textAppearanceTitleSmall</item><!--sesl-->
    <item name="tabTextColor">@color/m3_tabs_text_color</item>
    <!--<item name="tabIndicator">@drawable/m3_tabs_rounded_line_indicator</item>-->
    <item name="tabIndicatorAnimationMode">elastic</item>
    <item name="tabIndicatorColor">?colorPrimary</item><!--sesl-->
    <item name="tabRippleColor">@color/m3_tabs_ripple_color</item>
    <item name="tabIndicatorFullWidth">false</item>
    <item name="tabIndicatorAnimationDuration">?attr/motionDurationLong2</item>
    <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.TabLayout</item>
  </style>

  <style name="ThemeOverlay.Material3.TabLayout" parent="">
    <item name="badgeStyle">@style/Widget.Material3.Badge</item>
  </style>

  <style name="Widget.Material3.TabLayout" parent="Base.Widget.Material3.TabLayout">
    <item name="android:background">@drawable/m3_tabs_background</item>
    <item name="tabUnboundedRipple">false</item>
  </style>

  <!-- Styles for M3 Tabs used on an elevatable surface. -->
  <style name="Base.Widget.Material3.TabLayout.OnSurface" parent="Widget.Material3.TabLayout">
    <item name="android:background">@android:color/transparent</item>
  </style>

  <style name="Widget.Material3.TabLayout.OnSurface" parent="Base.Widget.Material3.TabLayout.OnSurface"/>

  <!-- Style for M3 secondary tabs, which are used as an alternate when primary tabs are already
       present in the UI. -->
  <style name="Base.Widget.Material3.TabLayout.Secondary" parent="Widget.Material3.TabLayout">
    <item name="android:background">?colorSurface</item><!--sesl-->
    <item name="tabIconTint">@color/m3_tabs_icon_color_secondary</item>
    <item name="tabTextAppearance">?textAppearanceTitleSmall</item><!--sesl-->
    <item name="tabTextColor">@color/m3_tabs_text_color_secondary</item>
    <item name="tabIndicator">@drawable/m3_tabs_line_indicator</item>
    <item name="tabIndicatorColor">?colorPrimary</item><!--sesl-->
    <item name="tabRippleColor">@color/m3_tabs_ripple_color_secondary</item>
    <item name="tabIndicatorFullWidth">true</item>
  </style>

  <style name="Widget.Material3.TabLayout.Secondary" parent="Base.Widget.Material3.TabLayout.Secondary">
    <item name="android:background">@drawable/m3_tabs_background</item>
  </style>

  <!--Sesl-->
  <style name="TextAppearance.Design.Tab.Light" parent="@style/TextAppearance.Design.Tab">
    <item name="android:textColor">@color/sesl_tablayout_text_color</item>
  </style>

  <style name="Widget.Design.TabLayout.Light" parent="Widget.V7.Design.TabLayout.Light"/>
  <style name="Widget.V7.Design.TabLayout.Light" parent="@style/Widget.Design.TabLayout">
    <item name="seslTabSubTextAppearance">@style/TextAppearance.Design.Tab.SubText.Light</item>
    <item name="tabBackground">@drawable/sesl_tabview_transparent_ripple_background_light</item>
    <item name="tabIndicatorColor">@color/sesl_tablayout_selected_indicator_color</item>
    <item name="tabSelectedTextColor">@color/sesl_tablayout_selected_text_color</item>
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab.Light</item>
  </style>

  <style name="TextAppearance.Design.Tab.SubText" parent="@style/TextAppearance.Design.Tab">
    <item name="android:textSize">@dimen/sesl_tab_sub_text_size</item>
    <item name="android:textColor">@color/sesl_tablayout_subtab_sub_text_color_dark</item>
    <item name="android:fontFamily">@string/sesl_font_family_regular</item>
  </style>

  <style name="TextAppearance.Design.Tab.SubText.Light" parent="@style/TextAppearance.Design.Tab.SubText">
    <item name="android:textColor">@color/sesl_tablayout_subtab_sub_text_color_light</item>
  </style>
  <!--sesl-->

  <!--Sesl9-->
  <style name="TextAppearance.Design.Tab.IconText" parent="@style/TextAppearance.Design.Tab">
    <item name="android:textSize">@dimen/sesl_tab_icon_text_size</item>
  </style>

  <style name="TextAppearance.Design.Tab.IconText.Light" parent="@style/TextAppearance.Design.Tab.IconText">
    <item name="android:textColor">@color/sesl_tablayout_text_color</item>
  </style>

  <style name="Widget.Design.TabLayout.Main" parent="@style/Widget.Design.TabLayout">
    <item name="android:background">@android:color/transparent</item>
    <item name="seslTabStyle">Main</item>
    <item name="tabBackground">@drawable/sesl_tabview_maintab_ripple_background_dark</item>
    <item name="tabGravity">center</item>
    <item name="tabMode">sesl_main</item>
  </style>

  <style name="Widget.Design.TabLayout.Main.BlurBackground" parent="@style/Widget.Design.TabLayout.Main">
    <item name="android:background">@drawable/sesl_tablayout_maintab_background_dark</item>
    <item name="android:elevation">@dimen/sesl_tablayout_floating_navigation_elevation</item>
    <item name="seslTabApplyBlur">true</item>
  </style>

  <style name="Widget.Design.TabLayout.Main.BlurBackground.IconText" parent="@style/Widget.Design.TabLayout.Main.BlurBackground">
    <item name="seslTabSelectedSideMargin">@dimen/sesl_tablayout_maintab_selected_side_margin_icon_text</item>
    <item name="seslTabSeparatorMargin">@dimen/sesl_tablayout_maintab_side_margin_icon_text</item>
    <item name="tabMinWidth">@dimen/sesl_tablayout_text_and_icon_width</item>
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab.IconText</item>
  </style>

  <style name="Widget.Design.TabLayout.Light.Main" parent="@style/Widget.Design.TabLayout.Light">
    <item name="android:background">@android:color/transparent</item>
    <item name="seslTabStyle">Main</item>
    <item name="tabBackground">@drawable/sesl_tabview_maintab_ripple_background_light</item>
    <item name="tabGravity">center</item>
    <item name="tabMode">sesl_main</item>
  </style>

  <style name="Widget.Design.TabLayout.Light.Main.BlurBackground" parent="@style/Widget.Design.TabLayout.Light.Main">
    <item name="android:background">@drawable/sesl_tablayout_maintab_background_light</item>
    <item name="android:elevation">@dimen/sesl_tablayout_floating_navigation_elevation</item>
    <item name="seslTabApplyBlur">true</item>
  </style>

  <style name="Widget.Design.TabLayout.Light.Main.BlurBackground.IconText" parent="@style/Widget.Design.TabLayout.Light.Main.BlurBackground">
    <item name="seslTabSelectedSideMargin">@dimen/sesl_tablayout_maintab_selected_side_margin_icon_text</item>
    <item name="seslTabSeparatorMargin">@dimen/sesl_tablayout_maintab_side_margin_icon_text</item>
    <item name="tabMinWidth">@dimen/sesl_tablayout_text_and_icon_width</item>
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab.IconText.Light</item>
  </style>

  <style name="Widget.Design.TabLayout.Main.IconText" parent="@style/Widget.Design.TabLayout.Main">
    <item name="seslTabSelectedSideMargin">@dimen/sesl_tablayout_maintab_selected_side_margin_icon_text</item>
    <item name="seslTabSeparatorMargin">@dimen/sesl_tablayout_maintab_side_margin_icon_text</item>
    <item name="tabMinWidth">@dimen/sesl_tablayout_text_and_icon_width</item>
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab.IconText</item>
  </style>

  <style name="Widget.Design.TabLayout.Light.Main.IconText" parent="@style/Widget.Design.TabLayout.Light.Main">
    <item name="seslTabSelectedSideMargin">@dimen/sesl_tablayout_maintab_selected_side_margin_icon_text</item>
    <item name="seslTabSeparatorMargin">@dimen/sesl_tablayout_maintab_side_margin_icon_text</item>
    <item name="tabMinWidth">@dimen/sesl_tablayout_text_and_icon_width</item>
    <item name="tabTextAppearance">@style/TextAppearance.Design.Tab.IconText.Light</item>
  </style>
  <!--sesl9-->

</resources>
